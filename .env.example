# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub: personal access token with `repo` scope, used to open fix PRs
GITHUB_TOKEN=

# Vercel: API token (VERCEL_ACCESS_TOKEN is accepted as an alias), and the team the projects live in (defaults to the original team slug)
VERCEL_TOKEN=
VERCEL_TEAM_SLUG=

# Slack: incoming webhook for alerts, token that /devops requests must carry, bot token
SLACK_WEBHOOK_URL=
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>` to /api/monitor and /api/digest
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
